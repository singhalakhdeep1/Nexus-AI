# ============================================================
# SUPABASE CONFIG — Get these from your Supabase project settings
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (server-side only — NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Direct database connection for Drizzle ORM migrations
DATABASE_URL=postgresql://postgres:password@localhost:5432/nexusflow

# ============================================================
# OPENAI — For AI-powered features (task generation, summarization)
# ============================================================
OPENAI_API_KEY=sk-your-openai-api-key-here

# ============================================================
# APP CONFIG
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=NexusFlow
NEXT_PUBLIC_APP_VERSION=1.0.0

# ============================================================
# STRIPE — Billing and subscriptions
# ============================================================
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_PRO_PRICE_ID=price_your-pro-plan-price-id

# ============================================================
# UPSTASH — Redis and rate limiting
# ============================================================
UPSTASH_REDIS_REST_URL=https://your-upstash-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# QSTASH — Background job queue
QSTASH_TOKEN=your-qstash-token

# ============================================================
# REDIS — Local development cache (docker-compose)
# ============================================================
REDIS_HOST=localhost
REDIS_PORT=6379

# ============================================================
# LIVEBLOCKS — Real-time collaboration
# ============================================================
LIVEBLOCKS_SECRET_KEY=sk_your-liveblocks-secret-key

# ============================================================
# EMAIL — Transactional emails via Resend
# ============================================================
RESEND_API_KEY=re_your-resend-api-key
EMAIL_FROM=noreply@yourdomain.com

# ============================================================
# MONITORING & ANALYTICS
# ============================================================
# Sentry — Error tracking
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=nexusflow

# PostHog — Product analytics
NEXT_PUBLIC_POSTHOG_KEY=phc_your-posthog-key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ============================================================
# AI SERVICES (optional)
# ============================================================
# HuggingFace — Alternative AI models
HUGGINGFACE_API_KEY=hf_your-huggingface-key

# MLflow — ML experiment tracking
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_API_KEY=your-mlflow-api-key

# ============================================================
# TESTING
# ============================================================
# E2E test credentials
E2E_TEST_EMAIL=test@example.com
E2E_TEST_PASSWORD=test-password-here
PLAYWRIGHT_BASE_URL=http://localhost:3000

# ============================================================
# DEPLOYMENT (set by hosting platform, usually auto-populated)
# ============================================================
# VERCEL_URL is auto-set by Vercel
# NEXT_RUNTIME is auto-set by Next.js
